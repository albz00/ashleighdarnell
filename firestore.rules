rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /site/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll([
          'id',
          'name',
          'email',
          'joinedAt',
          'status',
          'consentedAt',
          'source'
        ]) &&
        request.resource.data.keys().hasOnly([
          'id',
          'name',
          'email',
          'joinedAt',
          'status',
          'consentedAt',
          'source'
        ]) &&
        request.resource.data.id == subscriberId &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.joinedAt is string &&
        request.resource.data.consentedAt is string &&
        request.resource.data.source in ['contact-form', 'footer'] &&
        request.resource.data.status == 'active'
      );
    }
  }
}
